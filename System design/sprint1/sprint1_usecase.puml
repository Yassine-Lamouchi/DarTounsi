@startuml Sprint1_UseCase
' ============================================
' DarTounsi - Sprint 1: Identity & Trust
' Use Case Diagram (UML 2.0)
' ============================================

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFF8F0
  BorderColor #E85D04
  ArrowColor #333333
}
skinparam actor {
  BorderColor #333333
}

rectangle "DarTounsi — Sprint 1: Identity & Trust" as System #FEFAF0 {

  usecase "Register\n(Email)" as UC_REG
  usecase "Register via\nGoogle OAuth" as UC_OAUTH
  usecase "Select Role\n(Tenant/Owner/Hotel)" as UC_ROLE
  usecase "Login" as UC_LOGIN
  usecase "View Bento\nDashboard" as UC_DASH
  usecase "Complete Lifestyle\nQuestionnaire" as UC_QUEST
  usecase "View Verification\nBadges" as UC_VERIF
  usecase "Manage\nProfile" as UC_PROFILE
  usecase "Verify User\nAccount" as UC_ADMIN_VER
}

actor "Visitor" as Visitor
actor "Tenant" as Tenant
actor "Owner" as Owner
actor "Admin" as Admin
actor "Google API" <<external>> as Google

' --- Generalizations ---
Tenant -u-|> Visitor : <<extends>>
Owner -u-|> Visitor : <<extends>>

' --- Visitor associations ---
Visitor --> UC_REG
Visitor --> UC_OAUTH
Visitor --> UC_LOGIN

' --- Tenant associations ---
Tenant --> UC_DASH
Tenant --> UC_QUEST
Tenant --> UC_PROFILE

' --- Owner associations ---
Owner --> UC_DASH
Owner --> UC_PROFILE

' --- Admin associations ---
Admin --> UC_ADMIN_VER
Admin --> UC_DASH

' --- External system ---
Google --> UC_OAUTH

' --- Relationships ---
UC_REG ..> UC_ROLE : <<include>>
UC_OAUTH ..> UC_ROLE : <<include>>
UC_REG <.. UC_OAUTH : <<extend>>\n{OAuth selected}
UC_LOGIN ..> UC_DASH : <<include>>

@enduml
